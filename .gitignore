# Secrets — never commit
.env
.env.*
!.env.example

# Local Claude Code settings — machine-specific, can capture command args
.claude/

# Dependencies
node_modules/

# STEPBible source data — fetched with `npm run fetch-data`, not redistributed
# (the CC BY 4.0 notice asks that it be distributed from a single source)
data/

# Logs
*.log
npm-debug.log*

# OS cruft
.DS_Store

# Phase 3 QA (Playwright) — generated per-run, not part of the checked-in
# suite (qa/tests/, qa/CHECKLIST.md, qa/BUGS.md, qa/REPORT.md all are).
qa/playwright-report/
qa/screenshots/
/test-results/
blob-report/
