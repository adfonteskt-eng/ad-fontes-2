# Get an app key at https://developers.youversion.com
YVP_APP_KEY=your-app-key-here

# Comma-separated YouVersion Bible version ids to fetch, in the order shown.
# Defaults to BSB, KJV, WEB, ASV (3034,1,206,12) if neither this nor BIBLE_ID
# is set. Set this if your app key only has access to a different set of
# translations.
# BIBLE_IDS=3034,1,206,12

# Single-translation override (kept for backward compatibility — same as
# setting BIBLE_IDS to one id). Only takes effect if BIBLE_IDS is unset.
# BIBLE_ID=3034

# Get a key at https://console.anthropic.com — enables the AI-generated
# summary (plain-language takeaway + study notes) at the end of the output.
# Optional: everything else works without it, you just won't get a summary.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Which Claude model generates the summary. Defaults to claude-sonnet-5.
# SUMMARY_MODEL=claude-sonnet-5

# Optional: makes chat session history durable across server restarts/
# redeploys via Upstash Redis (https://upstash.com — free tier, no credit
# card). Get both values from your database's REST API section in the
# Upstash console. Without these, chat sessions fall back to in-memory
# storage — fine for local development, but lost on every restart, which
# is a real problem on a host like Render that redeploys/restarts the
# process regularly.
# UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Optional: daily per-IP caps on Anthropic-backed requests, to bound
# worst-case API spend during the free beta (there's no login yet to meter
# against, so an IP address is what's available). Defaults shown below are
# generous for genuine use and only matter as a ceiling against a runaway
# or abusive client. Uses the same Redis/in-memory storage as sessions above
# — with Redis configured, the cap survives a restart; without it, a
# restart quietly resets everyone's count.
# CHAT_DAILY_LIMIT=60
# SUMMARY_DAILY_LIMIT=40
