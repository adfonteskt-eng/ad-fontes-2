# Get an app key at https://developers.youversion.com
YVP_APP_KEY=your-app-key-here

# Comma-separated YouVersion Bible version ids to fetch, in the order shown.
# Defaults to BSB, KJV, WEB, ASV (3034,1,206,12) if neither this nor BIBLE_ID
# is set. Set this if your app key only has access to a different set of
# translations.
# BIBLE_IDS=3034,1,206,12

# Single-translation override (kept for backward compatibility — same as
# setting BIBLE_IDS to one id). Only takes effect if BIBLE_IDS is unset.
# BIBLE_ID=3034

# Get a key at https://console.anthropic.com — enables the AI-generated
# summary (plain-language takeaway + study notes) at the end of the output.
# Optional: everything else works without it, you just won't get a summary.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Which Claude model generates the summary. Defaults to claude-sonnet-5.
# SUMMARY_MODEL=claude-sonnet-5

# Optional: makes chat session history durable across server restarts/
# redeploys via Upstash Redis (https://upstash.com — free tier, no credit
# card). Get both values from your database's REST API section in the
# Upstash console. Without these, chat sessions fall back to in-memory
# storage — fine for local development, but lost on every restart, which
# is a real problem on a host like Render that redeploys/restarts the
# process regularly.
# UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Optional: daily per-IP caps on Anthropic-backed requests, to bound
# worst-case API spend during the free beta (there's no login yet to meter
# against, so an IP address is what's available). Defaults shown below are
# generous for genuine use and only matter as a ceiling against a runaway
# or abusive client. Uses the same Redis/in-memory storage as sessions above
# — with Redis configured, the cap survives a restart; without it, a
# restart quietly resets everyone's count.
# CHAT_DAILY_LIMIT=60
# SUMMARY_DAILY_LIMIT=40

# Optional: accounts + compounding study memory, via Supabase
# (https://supabase.com — free tier, no credit card). Without these, chat
# works exactly as before, just without an account to remember anything
# across conversations, or a "previous conversations" menu to browse.
# Get all three from your project's Settings -> API Keys page: run
# supabase/schema.sql in the SQL Editor first (creates the
# profiles/study_entries/conversations tables), then copy:
#   - SUPABASE_URL: your project URL (https://xxxxx.supabase.co)
#   - SUPABASE_PUBLISHABLE_KEY: the "Publishable key" (safe to expose in a
#     browser — the frontend gets this from GET /api/config, not from a
#     bundled file, so there's nothing to hardcode). Called "anon" key on
#     the Legacy API Keys tab if your project predates the newer naming.
#   - SUPABASE_SECRET_KEY: the "Secret key" — NEVER expose this one to the
#     browser. Called "service_role" key on the Legacy API Keys tab.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Optional: the daily digest email (`npm run digest`, see
# scripts/send-daily-digest.js and lib/daily-digest.js) — sends today's
# featured passage to every signed-in user who's opted in. Requires
# Supabase to be configured above (that's where the opted-in user list
# comes from). Get an API key at https://resend.com/api-keys — this can be
# the SAME Resend account already used for Supabase's custom SMTP (magic
# links), just a separate key, since Supabase never hands that key back out
# to this app. DIGEST_FROM_EMAIL must be an address at a domain you've
# verified with Resend.
# RESEND_API_KEY=re_your-resend-api-key-here
# DIGEST_FROM_EMAIL="ad fontes <digest@adfontes.site>"

# Optional: overrides the link the digest email points back to. Defaults to
# https://adfontes.site (this app's real domain) if unset — only worth
# setting if you're running the digest against a different deployment.
# PUBLIC_SITE_URL=https://adfontes.site
